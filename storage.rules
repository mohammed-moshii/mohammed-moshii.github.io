rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email in ['backman480@gmail.com'];
    }

    // Writeup images
    // Public can read, only admin can upload images (max 10MB, image MIME type only)
    match /writeups/{imageId} {
      allow read: if true;
      allow write: if isAdmin() 
                   && request.resource.size < 10 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
