rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the authenticated user is the designated admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email in ['backman480@gmail.com'];
    }

    // Public machines & writeups:
    // Anyone can read targets
    // Only the verified admin can create, update, or delete
    match /machines/{machineId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin 2FA Secrets:
    // Strictly restricted to the authorized admin only
    match /admin_secrets/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
    }

    // Site Traffic & Visitor Statistics:
    // Legitimate visitors can only increment/record counts on the 'traffic' document.
    // Arbitrary document injection and deletions are blocked.
    // Reading stats is restricted to the verified admin.
    match /site_stats/{statId} {
      allow read: if isAdmin();
      allow create, update: if statId == 'traffic' 
        && request.resource.data.keys().hasOnly(['count', 'lastVisit'])
        && request.resource.data.count is int;
      allow delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
